{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "rm -rf .astro && astro dev",
    "start": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "astro": "astro",
    "format:astro": "prettier --write src/**/*.astro --plugin=prettier-plugin-astro",
    "format": "biome format --write . && pnpm run strip-trailing",
    "tsc": "tsc",
    "seo": "node scripts/seo-check.mjs https://simho.xyz",
    "verify": "node --check scripts/umami-site-ensure.mjs && node --check scripts/seo-check.mjs && node --check scripts/umami-track-verify.mjs && bash -n scripts/vercel-wait.sh && node scripts/seo-check.mjs https://simho.xyz",
    "strip-trailing": "git ls-files '*.js' '*.ts' '*.json' '*.md' '*.astro' | tr '\\n' '\\0' | xargs -0 sed -i 's/[[:space:]]*$//'",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@fontsource/iosevka-aile": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-embed": "^0.14.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "^2.5.14",
    "@iconify/json": "^2.2.533",
    "@iconify/tailwind4": "^1.2.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.3",
    "@types/unist": "^3.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide"
    ]
  },
  "packageManager": "pnpm@10.19.0+sha512.c9fc7236e92adf5c8af42fd5bf1612df99c2ceb62f27047032f4720b33f8eacdde311865e91c411f2774f618d82f320808ecb51718bfa82c060c4ba7c76a32b8"
}
